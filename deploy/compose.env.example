# Copy this file to compose.env and replace all blank values.
# Keep compose.env private; it is excluded from Git and Docker builds.

# The TermChat LXC's static LAN address. Nginx connects to this address.
TERMCHAT_BIND_IP=
TERMCHAT_PORT=8080

POSTGRES_DB=termchat
POSTGRES_USER=termchat
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=

# Generate separately with: openssl rand -hex 32
# Keep this value stable across updates or existing sessions are invalidated.
TERMCHAT_JWT_SECRET=
TERMCHAT_TOKEN_TTL=24h
TERMCHAT_CLEANUP_INTERVAL=1h

# Use an immutable tag such as termchat-server:<git-commit> for releases.
TERMCHAT_IMAGE=termchat-server:local
